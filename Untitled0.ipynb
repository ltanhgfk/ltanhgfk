#Viết chương trình:
#1. Tạo hai vector A và B, mỗi vector có 4 phần tử.
#2. Tính Dot Product.
#3. Tạo hai ma trận có kích thước 2 × 3 và 3 × 2.
#4. Thực hiện Matrix Multiplication.
#5. In kết quả và Shape của ma trận đầu ra.
#Gợi ý: Sử dụng np.dot(), np.matmul() và .shape.

import numpy as np
A= np.array([1,2,3,4])
B= np.array([5,6,7,8])
print(A, "Shape A" , A.shape)
print(B, "Shape B" , B.shape)
dot = np.dot(A,B)
print(dot)
m1=np.array([
    [1,2],
    [3,4],
    [5,6]
])
m2 = np.array([
    [6,7],
    [8,9],
    [0,1]
])

print(m1, "Shape A" , m1.shape)
print(m2, "Shape A" , m1.shape)

matmul12 = np.matmul(m1,m2.T) # T: transpose  để chuyển matran 2,3 thành 3,2 mới nhân 2 ma trận được
print("matmul:", matmul12, "Shape matmul: ", matmul12.shape)

